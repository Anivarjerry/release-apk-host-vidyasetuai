<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="120"
    android:viewportHeight="120">
    <!-- Centering the 100x32 bridge logo inside a square 120x120 viewport.
         Horizontal offset = (120 - 100) / 2 = 10
         Vertical offset = (120 - 32) / 2 = 44 -->
