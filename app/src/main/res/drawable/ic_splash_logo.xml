        android:translateX="10"
        android:translateY="44">
        <path
            android:fillColor="#FF10B981"
            android:pathData="M 0 32 L 21.43 32 Q 50 6 78.57 32 L 100 32 Q 50 0 0 32 Z" />
    </group>
</vector>
